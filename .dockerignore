# The build context only needs each service's executable jar; everything else (sources, docs, .env) stays out of the image.
# Jars are listed one by one instead of !*/target/*.jar: once * has excluded the top-level dirs, older builders don't descend into them for a wildcard re-include
*
!GateWay/target/GateWay-0.0.1-SNAPSHOT.jar
!UserService/target/UserService-0.0.1-SNAPSHOT.jar
!ProductInventoryService/target/ProductInventoryService-0.0.1-SNAPSHOT.jar
!OrderService/target/OrderService-0.0.1-SNAPSHOT.jar
!PaymentService/target/PaymentService-0.0.1-SNAPSHOT.jar
!RealTimeService/target/RealTimeService-0.0.1-SNAPSHOT.jar
