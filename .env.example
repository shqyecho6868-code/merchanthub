# 复制为 .env 后填写；.env 不提交到 git
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
# Base64 字符串，解码后至少 32 字节，可用：openssl rand -base64 32
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
# Nacos 控制台管理员（首次启动后需初始化密码，见 docs/env-setup.md）
NACOS_USERNAME=nacos
NACOS_PASSWORD=
# Sentinel 控制台密码（C2），不填默认 sentinel
SENTINEL_PASSWORD=
# D1：JWT 签名密钥（网关 / user-tenant / realtime 共用）。必须是补齐的标准 Base64、解码后至少 32 字节：openssl rand -base64 32
JWT_SECRET=

# E3：XXL-Job 调度中心与执行器之间的通信令牌（两边必须一致）。随便生成一个：openssl rand -hex 16
XXL_JOB_ACCESS_TOKEN=
