# Copy to .env and fill in; .env is never committed
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
# Base64 string, at least 32 bytes after decoding. Generate with: openssl rand -base64 32
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
# Nacos console admin (the password must be initialized after the first start)
NACOS_USERNAME=nacos
NACOS_PASSWORD=
# Sentinel console password; defaults to sentinel if empty
SENTINEL_PASSWORD=
# JWT signing key (shared by gateway / user-tenant / realtime). Must be padded standard Base64, at least 32 bytes decoded: openssl rand -base64 32
JWT_SECRET=

# Access token between the XXL-Job admin and executors (must match on both sides). Generate one with: openssl rand -hex 16
XXL_JOB_ACCESS_TOKEN=

# Grafana admin password (load-test dashboards, docker compose --profile perf); defaults to admin if empty
GRAFANA_PASSWORD=
