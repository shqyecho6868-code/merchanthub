<?xml version="1.0" encoding="UTF-8"?>
<!--
  Product listing approval (D1). Process definition = template, one for the whole platform; each product submission for review = one process instance (businessKey = listing:merchant:product:round).
  Reject = instance ends (doesn't go back to first review): the product is edited in the product service and the engine can't know when editing is done; after editing, a new submission starts a new instance (D1 notes 2.2).
  On end, listingResultListener writes the approval record + local outbox table in the same transaction as "completing the last task" -> RocketMQ -> product writes back the status.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://merchanthub.com/approval">

  <process id="productListing" name="Product Listing Approval" isExecutable="true">

    <startEvent id="start" name="Submit Listing"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="merchantReview"/>

    <!-- Candidate group includes the merchant ID: merchant 7's products only go to group "MERCHANT_ADMIN:7", so merchant 8's admin can't even find them when querying tasks -->
    <userTask id="merchantReview" name="Merchant Admin First Review" flowable:candidateGroups="MERCHANT_ADMIN:${tenantId}"/>
    <sequenceFlow id="f2" sourceRef="merchantReview" targetRef="merchantDecision"/>

    <exclusiveGateway id="merchantDecision" name="First Review Result"/>
    <sequenceFlow id="f3" sourceRef="merchantDecision" targetRef="platformReview">
      <conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f4" sourceRef="merchantDecision" targetRef="rejectedEnd">
      <conditionExpression xsi:type="tFormalExpression">${!approved}</conditionExpression>
    </sequenceFlow>

    <userTask id="platformReview" name="Platform Admin Second Review" flowable:candidateGroups="PLATFORM_ADMIN"/>
    <sequenceFlow id="f5" sourceRef="platformReview" targetRef="platformDecision"/>

    <exclusiveGateway id="platformDecision" name="Second Review Result"/>
    <sequenceFlow id="f6" sourceRef="platformDecision" targetRef="approvedEnd">
      <conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f7" sourceRef="platformDecision" targetRef="rejectedEnd">
      <conditionExpression xsi:type="tFormalExpression">${!approved}</conditionExpression>
    </sequenceFlow>

    <!--
      Use expression to call a method and pass the result as an argument, rather than delegateExpression + field injection:
      Spring beans are singletons, so field injection would be overwritten by concurrent process instances (a warning in the official Flowable docs)
    -->
    <endEvent id="approvedEnd" name="Approved">
      <extensionElements>
        <flowable:executionListener event="start" expression="${listingResultListener.onEnd(execution, 'APPROVED')}"/>
      </extensionElements>
    </endEvent>
    <endEvent id="rejectedEnd" name="Rejected">
      <extensionElements>
        <flowable:executionListener event="start" expression="${listingResultListener.onEnd(execution, 'REJECTED')}"/>
      </extensionElements>
    </endEvent>
  </process>
</definitions>
