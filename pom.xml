<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.11</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.merchanthub</groupId>
	<artifactId>merchanthub</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>MerchantHub</name>
	<description>MerchantHub multi-tenant e-commerce trading platform</description>

	<modules>
		<!-- Maven orders the build by inter-module dependencies; this order is only for readability: base modules first, business services after -->
		<module>TestSupport</module>
		<module>Common</module>
		<module>ProductInventoryService</module>
		<module>OrderService</module>
		<module>PaymentService</module>
		<module>UserService</module>
		<module>GateWay</module>
		<module>RealTimeService</module>
	</modules>

	<packaging>pom</packaging>

	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>17</java.version>
		<!-- Version combination per the official SCA version guide: SCA 2025.0.0.0 <-> Spring Cloud 2025.0.0 <-> Spring Boot 3.5.x -->
		<spring-cloud.version>2025.0.0</spring-cloud.version>
		<spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version>
		<mybatis-plus.version>3.5.12</mybatis-plus.version>
		<jjwt.version>0.11.5</jjwt.version>
		<hutool.version>5.7.17</hutool.version>
		<commons-lang3.version>3.12.0</commons-lang3.version>
		<!--
		  Do NOT define netty.version here: it clashes with the same-named property in the Spring Boot parent and would override every Netty module
		  in the project (Gateway's Reactor Netty, Lettuce, RocketMQ remoting) at once. Pinning it to 4.2.0 once left the RocketMQ client
		  unable to reach the NameServer. Let Boot manage the Netty version (4.1.x for 3.5.x).
		-->
		<canal.version>1.1.7</canal.version>
		<!--
		  Must match the com.alibaba:fastjson managed by the SCA BOM (the 2.x compatibility layer, 2.0.58): the layer calls the fastjson2 core directly,
		  so mismatched versions fail at runtime with NoSuchMethodError. It was once pinned to 2.0.31 to match canal 1.1.7, which broke RocketMQ client requests.
		-->
		<fastjson2.version>2.0.58</fastjson2.version>
		<!-- Distributed scheduling (replaces ShedLock). 3.x requires JDK 17 / Spring 6, matching this project's baseline -->
		<xxl-job.version>3.4.2</xxl-job.version>
		<!--
		  Flowable 7.2.0 is built on Spring Boot 3.5.4 / Spring 6.2 / MyBatis 3.5.19,
		  matching this project's Boot 3.5.x and MyBatis-Plus 3.5.12 (also on MyBatis 3.5.19), so there are never two MyBatis versions
		-->
		<flowable.version>7.2.0</flowable.version>

		<!-- Testing and coverage -->
		<!-- Product images in S3. Only the s3 module's presigning and HeadObject are used; the HTTP client is the JDK url-connection one (see ProductInventoryService/pom.xml) -->
		<aws-sdk.version>2.34.0</aws-sdk.version>
		<jacoco.version>0.8.13</jacoco.version>
		<!--
		  The coverage gate is off by default: reports only, no threshold.
		  The order / inventory / payment modules set jacoco.check.skip=false in their own pom to enable the 70% line-coverage gate.
		-->
		<jacoco.check.skip>true</jacoco.check.skip>
		<jacoco.line.minimum>0.70</jacoco.line.minimum>
	</properties>

	<!--
	  The root pom only holds dependencies that every module needs and that never reach runtime:
	  lombok (compile-time annotation processing) and starter-test (test scope).
	  Everything else is version-managed in dependencyManagement and declared by each module as needed.
	-->
	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.alibaba.cloud</groupId>
				<artifactId>spring-cloud-alibaba-dependencies</artifactId>
				<version>${spring-cloud-alibaba.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!--
			  Test framework BOMs. Versions reuse the Spring Boot parent's properties (junit-jupiter.version / mockito.version /
			  testcontainers.version) instead of literal numbers: this lists explicitly which test frameworks the project uses while staying identical to Boot's managed versions,
			  so they move with Boot upgrades and never conflict.
			  Note: Testcontainers 1.21.x has no RocketMQ module, so RocketMQ runs in a GenericContainer (see the sample IT in Common).
			-->
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>bom</artifactId>
				<version>${aws-sdk.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit-jupiter.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.mockito</groupId>
				<artifactId>mockito-bom</artifactId>
				<version>${mockito.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Internal modules -->
			<dependency>
				<groupId>com.merchanthub</groupId>
				<artifactId>Common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.merchanthub</groupId>
				<artifactId>TestSupport</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Persistence -->
			<dependency>
				<groupId>com.baomidou</groupId>
				<artifactId>mybatis-plus-spring-boot3-starter</artifactId>
				<version>${mybatis-plus.version}</version>
			</dependency>
			<dependency>
				<groupId>com.baomidou</groupId>
				<artifactId>mybatis-plus-jsqlparser</artifactId>
				<version>${mybatis-plus.version}</version>
			</dependency>

			<!-- Utilities -->
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-api</artifactId>
				<version>${jjwt.version}</version>
			</dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-impl</artifactId>
				<version>${jjwt.version}</version>
			</dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-jackson</artifactId>
				<version>${jjwt.version}</version>
			</dependency>
			<dependency>
				<groupId>cn.hutool</groupId>
				<artifactId>hutool-all</artifactId>
				<version>${hutool.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-lang3</artifactId>
				<version>${commons-lang3.version}</version>
			</dependency>
			<dependency>
				<groupId>com.alibaba.fastjson2</groupId>
				<artifactId>fastjson2</artifactId>
				<version>${fastjson2.version}</version>
			</dependency>

			<!-- Middleware clients -->
			<dependency>
				<groupId>com.xuxueli</groupId>
				<artifactId>xxl-job-core</artifactId>
				<version>${xxl-job.version}</version>
			</dependency>
			<dependency>
				<groupId>com.alibaba.otter</groupId>
				<artifactId>canal.client</artifactId>
				<version>${canal.version}</version>
			</dependency>
			<dependency>
				<groupId>com.alibaba.otter</groupId>
				<artifactId>canal.protocol</artifactId>
				<version>${canal.version}</version>
			</dependency>

			<!-- Approval workflow; only user-tenant uses it -->
			<dependency>
				<groupId>org.flowable</groupId>
				<artifactId>flowable-spring-boot-starter-process</artifactId>
				<version>${flowable.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<!-- Managed only, not applied: Common is a plain jar and must not be repackaged into an executable jar -->
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
				</plugin>
			</plugins>
		</pluginManagement>

		<!--
		  Two test layers:
		    *Test / *Tests  -> surefire, test phase, pure unit tests, no Docker needed (mvn test)
		    *IT             -> failsafe, integration-test phase, real middleware via Testcontainers (mvn verify)
		  Why split: unit tests take seconds and can run anytime; integration tests pull images and start containers, are slow and need Docker. CI runs both.
		-->
		<plugins>
			<!--
			  Maven Toolchains: compile and test always use JDK 17, regardless of the JDK running Maven.
			  So ./mvnw verify works even when the default java is newer, without exporting JAVA_HOME;
			  Maven finds the JDK 17 path in ~/.m2/toolchains.xml (generated by setup-java in CI).
			  compiler / surefire / failsafe all use the JDK selected here, so Lombok runs under javac 17
			  and the test JVM (including the JaCoCo agent) is 17 too. If no JDK 17 is found, this step fails with a missing-toolchain error.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-toolchains-plugin</artifactId>
				<version>3.2.0</version>
				<executions>
					<execution>
						<goals>
							<goal>toolchain</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<toolchains>
						<jdk>
							<!-- A range rather than "17": a bare version requires an exact match, and setup-java in CI may register 17.0.x -->
							<version>[17,18)</version>
						</jdk>
					</toolchains>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<!-- Version and the integration-test / verify executions are managed by the Boot parent; only activation is needed here -->
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<!--
					  prepare-agent writes the JaCoCo agent into argLine; surefire and failsafe both read argLine
					  and append to the same target/jacoco.exec, so the report = merged unit + integration test coverage.
					  If a module ever customizes argLine it must be written as "@{argLine} -Xxx", otherwise the agent is dropped and coverage becomes 0.
					-->
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<!-- Bound to verify: report after integration tests finish. Output: <module>/target/site/jacoco/index.html and jacoco.csv -->
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<skip>${jacoco.check.skip}</skip>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>${jacoco.line.minimum}</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
