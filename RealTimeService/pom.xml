<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.merchanthub</groupId>
        <artifactId>merchanthub</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>RealTimeService</artifactId>
    <name>RealTimeService</name>
    <description>订单事件实时推送（Netty WebSocket，多节点路由 + 离线补发）</description>

    <dependencies>
        <dependency>
            <groupId>com.merchanthub</groupId>
            <artifactId>Common</artifactId>
        </dependency>
        <!-- 只用来注册到 Nacos、暴露健康检查；推送走 Netty 的 WebSocket 端口 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Common 的全局异常处理器引用了 jakarta.validation，Web 服务都要带上 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 路由表（用户连在哪台节点）、校验登录 token -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- E1：离线消息、商家通知、消费去重。表少、全是基础设施写法，用 JdbcTemplate 不引入 MyBatis：
             Netty / MQ 线程没有租户上下文，MyBatis 租户插件会 fail-closed，这里每条 SQL 自己写明 tenant_id -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- 版本交给 Spring Boot 管理（4.1.x），与 RocketMQ / Lettuce 用的 Netty 一致 -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
        </dependency>
        <!-- E1：Kafka → RocketMQ。订阅订单事件 + 节点间转发 -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-client</artifactId>
        </dependency>

        <dependency>
            <groupId>com.merchanthub</groupId>
            <artifactId>TestSupport</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
