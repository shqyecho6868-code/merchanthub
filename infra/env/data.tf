# ---------- Passwords: generated by Terraform, stored in SSM Parameter Store (standard parameters are free), injected as env vars when ECS starts a task ----------
# Note: random_password values are also written to the local terraform.tfstate (hence state isn't committed). Production: encrypted remote state, or RDS-managed passwords (Secrets Manager)
resource "random_password" "mysql" {
  length  = 24
  special = false # avoids JDBC URL / shell escaping issues
}

# JWT signing key, shared by gateway, user-tenant and realtime. The code requires standard Base64, at least 32 bytes decoded
resource "random_bytes" "jwt" {
  length = 32
}

resource "aws_ssm_parameter" "mysql_password" {
  name  = "/${var.name}/mysql-password"
  type  = "SecureString"
  value = random_password.mysql.result
}

resource "aws_ssm_parameter" "jwt_secret" {
  name  = "/${var.name}/jwt-secret"
  type  = "SecureString"
  value = random_bytes.jwt.base64
}

# ---------- RDS MySQL ----------
resource "aws_db_subnet_group" "main" {
  name       = var.name
  subnet_ids = aws_subnet.private[*].id
}

resource "aws_db_instance" "mysql" {
  identifier = var.name
  engine     = "mysql"
  # 8.4 (LTS) rather than the local 8.0: 8.0 is past standard support on RDS (2026-07), and new instances are automatically billed for Extended Support per vCPU-hour
  engine_version = "8.4"
  # Explicitly opt out of Extended Support: if the version goes past standard support, failing to create is better than silently paying more
  engine_lifecycle_support = "open-source-rds-extended-support-disabled"
  instance_class           = "db.t4g.micro"
  allocated_storage        = 20
  storage_type             = "gp3"
  username                 = "mhadmin"
  password                 = random_password.mysql.result
  db_subnet_group_name     = aws_db_subnet_group.main.name
  vpc_security_group_ids   = [aws_security_group.rds.id]
  publicly_accessible      = false
  multi_az                 = false
  # Ephemeral environment destroyed the same day: no backups, no final snapshot, no deletion protection -- otherwise destroy fails or leaves billable snapshots
  backup_retention_period  = 0
  skip_final_snapshot      = true
  delete_automated_backups = true
  deletion_protection      = false
  apply_immediately        = true
  # Each service creates its own database via createDatabaseIfNotExist (mh_order, mh_payment ...), same as locally; not created here
}

# ---------- ElastiCache Redis ----------
resource "aws_elasticache_subnet_group" "main" {
  name       = var.name
  subnet_ids = aws_subnet.private[*].id
}

# Single node, no in-transit encryption / AUTH: private subnet + security group admits ECS only. Trade-off: plaintext inside the VPC; production should enable TLS + AUTH token
resource "aws_elasticache_cluster" "redis" {
  cluster_id         = var.name
  engine             = "redis"
  engine_version     = "7.1"
  node_type          = "cache.t4g.micro"
  num_cache_nodes    = 1
  port               = 6379
  subnet_group_name  = aws_elasticache_subnet_group.main.name
  security_group_ids = [aws_security_group.redis.id]
  apply_immediately  = true
}

# ---------- S3: product images (replaces MinIO) + ops files ----------
resource "random_id" "bucket" {
  byte_length = 4
}

resource "aws_s3_bucket" "assets" {
  bucket        = "${var.name}-assets-${random_id.bucket.hex}" # bucket names are globally unique, so add a random suffix
  force_destroy = true                                         # destroy also deletes the images inside, instead of getting stuck on a non-empty bucket
}

# Public read only for the products/ prefix (product images are meant for every buyer anyway); seed SQL etc. under ops/ stays private.
# Writes only via presigned URLs issued by the service
resource "aws_s3_bucket_public_access_block" "assets" {
  bucket                  = aws_s3_bucket.assets.id
  block_public_acls       = true
  ignore_public_acls      = true
  block_public_policy     = false
  restrict_public_buckets = false
}

resource "aws_s3_bucket_policy" "assets" {
  bucket = aws_s3_bucket.assets.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid       = "PublicReadProductImages"
      Effect    = "Allow"
      Principal = "*"
      Action    = "s3:GetObject"
      Resource  = "${aws_s3_bucket.assets.arn}/products/*"
    }]
  })
  depends_on = [aws_s3_bucket_public_access_block.assets]
}

# Direct browser uploads need CORS (no frontend here and curl doesn't need it; kept so a future frontend can use it directly)
resource "aws_s3_bucket_cors_configuration" "assets" {
  bucket = aws_s3_bucket.assets.id
  cors_rule {
    allowed_methods = ["PUT", "GET"]
    allowed_origins = ["*"]
    allowed_headers = ["*"]
    max_age_seconds = 3000
  }
}

# Seed data: the middleware EC2 fetches it from here and loads it into RDS (RDS is in a private subnet, unreachable from a laptop)
resource "aws_s3_object" "seed" {
  bucket = aws_s3_bucket.assets.id
  key    = "ops/seed.sql"
  source = "${path.module}/../../perf/data/seed.sql"
  etag   = filemd5("${path.module}/../../perf/data/seed.sql")
}
