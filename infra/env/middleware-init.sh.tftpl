#!/bin/bash
# First-boot script for the middleware EC2. cloud-init runs it as root; output goes to /var/log/cloud-init-output.log
# (also visible from a laptop: aws ec2 get-console-output --instance-id <id> --latest --output text).
# Rendered by Terraform templatefile: $${...} is a Terraform variable, and $$ escapes to a shell $
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
# With retries: right after boot NAT egress sometimes isn't ready yet; once, the first apply failed here after 137 seconds unable to reach github.com
curl -fsSL --retry 10 --retry-all-errors --retry-delay 15 --connect-timeout 20 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose \
  https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# ES requires vm.max_map_count >= 262144, otherwise its bootstrap check fails
echo 'vm.max_map_count=262144' > /etc/sysctl.d/99-es.conf
sysctl --system

# The broker must register its host private IP with the NameServer: ECS tasks get this address and connect to the broker directly.
# Otherwise it registers the container IP (172.x), tasks can't reach it -> sends time out (same issue locally, see deploy/rocketmq/broker.conf)
TOKEN=$(curl -sX PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')
PRIVATE_IP=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)

mkdir -p /opt/mh/rocketmq-store
chown 3000:3000 /opt/mh/rocketmq-store
cat > /opt/mh/broker.conf <<CONF
brokerClusterName=DefaultCluster
brokerName=broker-a
brokerId=0
brokerRole=ASYNC_MASTER
flushDiskType=ASYNC_FLUSH
brokerIP1=$PRIVATE_IP
# Auto topic creation is disabled in the cloud; topics are created below up front (standard practice: topics are planned, not created on first send)
autoCreateTopicEnable=false
transactionCheckInterval=10000
CONF

cat > /opt/mh/compose.yml <<'COMPOSE'
${compose_file}
COMPOSE

cat > /opt/mh/.env <<ENV
AWS_REGION=${region}
LOG_GROUP=${log_group}
NACOS_AUTH_TOKEN=$(openssl rand -base64 32)
NACOS_IDENTITY=$(openssl rand -hex 16)
ENV

cd /opt/mh
docker compose -f compose.yml --env-file .env up -d

# Create topics once the broker has registered with the NameServer (same as deploy/b3/create-topics.sh); broker cold start takes tens of seconds, each topic retries for up to ~5 minutes
for T in ORDER_EVENT ORDER_TIMEOUT PAYMENT_EVENT PRODUCT_LISTING_RESULT; do
  for i in $(seq 1 30); do
    if docker compose -f compose.yml --env-file .env exec -T broker sh -c \
        "cd /home/rocketmq/rocketmq-*/bin && ./mqadmin updateTopic -n namesrv:9876 -c DefaultCluster -t $T" | grep -q success; then
      echo "Topic $T ready"; break
    fi
    sleep 10
  done
done
echo "MIDDLEWARE_READY"
