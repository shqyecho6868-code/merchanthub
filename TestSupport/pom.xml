<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.merchanthub</groupId>
        <artifactId>merchanthub</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>TestSupport</artifactId>
    <name>TestSupport</name>
    <description>集成测试共享基础设施：单例 Testcontainers 容器 + 测试基类。各服务只以 test 范围依赖它</description>

    <!--
      为什么单独建模块，而不是用 Common 的 test-jar：
      test-jar 不会把 Common 的 test 范围依赖（Testcontainers 等）传递出去，每个服务还得自己再声明一遍；
      独立模块里这些是 compile 依赖，服务以 test 范围引入 TestSupport 一次就全带上了。
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
        </dependency>

        <!-- 以下只给本模块的 MiddlewareContainersIT 用 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-client</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
